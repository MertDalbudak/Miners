# Copy to .env.production (or .env) and fill in.

# Google AdSense publisher ID (AdSense > Account > Account information).
# Production builds show no ads and load nothing from Google until this is set.
VITE_ADSENSE_CLIENT=ca-pub-0000000000000000

# on | test | off. Defaults: `npm run dev` shows Google's test ads,
# `npm run build` shows real ads (if the publisher ID is set).
# VITE_ADS=test

# Optional link to your privacy policy, shown on the About page.
# VITE_PRIVACY_URL=https://example.com/privacy
